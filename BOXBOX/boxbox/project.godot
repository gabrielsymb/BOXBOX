; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BOXBOX"
run/main_scene="res://Presentation/OpenWorld/OpenWorldPrototype.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=false

[dotnet]

project/assembly_name="BOXBOX"

[layer_names]

3d_physics/layer_1="Cenario"
3d_physics/layer_2="VeiculoTrafego"
3d_physics/layer_3="Pedestre"
3d_physics/layer_4="Jogador"
3d_physics/layer_5="VeiculoDirigivel"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
